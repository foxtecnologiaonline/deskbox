<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deskbox Celular"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Compartilhe a tela deste celular com o Deskbox no seu computador (mesma rede Wi-Fi). No Deskbox: Adicionar serviço → Celular Android → mostra IP, porta e código." />

        <Button
            android:id="@+id/buttonScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Escanear QR do Deskbox" />

        <EditText
            android:id="@+id/inputHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="IP do computador (ex.: 192.168.0.10)"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/inputPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Porta"
            android:importantForAutofill="no"
            android:inputType="number"
            android:text="47890" />

        <EditText
            android:id="@+id/inputCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Código de 6 dígitos (só no 1º pareamento)"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="6" />

        <Button
            android:id="@+id/buttonStartStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Iniciar compartilhamento" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Parado"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/buttonA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Abrir configurações de acessibilidade" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Sem o serviço de acessibilidade o Deskbox só espelha a tela (somente visualização). Para controlar: Acessibilidade → Apps instalados → Deskbox — controle remoto → Ativar."
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
